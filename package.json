{
  "name": "lingoflash",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/verify-node-runtime.mjs",
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build && node scripts/generate-build-metadata.mjs",
    "build:release": "npm run verify:release-config && npm run build",
    "predeploy:functions": "npm run verify:deploy",
    "predeploy:firestore": "npm run verify:deploy",
    "predeploy:hosting": "npm run verify:deploy && npm run build:release && npm run verify:secrets && npm run verify:bundle",
    "verify:release-config": "node --env-file-if-exists=.env.production scripts/verify-release-config.mjs",
    "verify:secrets": "node --env-file-if-exists=.env.local scripts/verify-build-secrets.mjs",
    "verify:bundle": "node scripts/bundle-budget.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:rules": "npx --yes firebase-tools@15.23.0 emulators:exec --only firestore --project demo-lingoflash \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:chromium": "npm run build && playwright test --project=chromium",
    "test:a11y": "npm run build && playwright test e2e/accessibility.spec.ts --project=chromium",
    "test:phase6": "vitest run src/features/releaseReadiness src/features/catalogCache/catalogIndex.test.ts src/features/catalogWorkspace/catalogWorkspaceOrchestration.test.ts src/features/session/identitySessionController.test.ts",
    "test:e2e:phase6": "npm run build && playwright test e2e/accessibility.spec.ts e2e/catalog-workspace.spec.ts e2e/sync-acceptance.spec.ts --project=chromium",
    "phase6:smoke": "vite-node scripts/phase6-operator.ts smoke",
    "phase6:canary": "vite-node scripts/phase6-operator.ts canary",
    "phase6:evidence": "vite-node scripts/phase6-operator.ts evidence",
    "catalog:validate": "node scripts/catalog-gate.mjs validate",
    "catalog:build": "node scripts/catalog-gate.mjs build",
    "catalog:verify": "node scripts/catalog-gate.mjs verify",
    "catalog:starter": "vite-node scripts/generate-starter-catalog.ts",
    "verify:core": "npm run lint && vitest run && npm --prefix functions run lint && npm --prefix functions test && npm --prefix functions run build && npm run test:rules",
    "verify:audit": "npm audit --audit-level=high && npm --prefix functions audit --audit-level=high",
    "verify:deploy": "npm run verify:core && npm run verify:audit",
    "verify": "npm run verify:core && npm run build && npm run verify:secrets && npm run verify:bundle && playwright test && npm run verify:audit && npm run phase6:evidence -- --verified",
    "test:all": "npm run verify"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@fontsource-variable/geist": "^5.2.9",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-dialog": "^1.1.19",
    "clsx": "^2.1.1",
    "firebase": "^12.14.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@google/genai": "^2.11.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
