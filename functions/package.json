{
  "name": "lingoflash-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "preinstall": "node -e \"const major = process.versions.node.split('.')[0]; if (major !== '22') throw new Error('Node.js 22.x is required; received ' + process.versions.node + '.')\"",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "ts-fsrs": "^5.4.1"
  },
  "overrides": {
    "fast-xml-parser": "^5.10.1",
    "postcss": "^8.5.23",
    "uuid": "^11.1.1"
  }
}
