rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Master Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Safety Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isTrustedAudioUrl(url) {
      return url is string
        && url.size() <= 2048
        && url.matches('^https://(api\\.dictionaryapi\\.dev|ssl\\.gstatic\\.com)/.*$');
    }

    function isTrustedImageUrl(url) {
      return url is string
        && url.size() <= 2048
        && (
          url.matches('^https://(images\\.pexels\\.com|images\\.unsplash\\.com|upload\\.wikimedia\\.org)/.*$')
          || isOwnFileImageUrl(url)
        );
    }

    // A photo the signed-in learner uploaded: the Cloud Storage download URL of
    // an object under users/{uid}/files/ in a project bucket (production or
    // staging), for their own uid. Any other object or bucket on the storage
    // host is refused. The client media policy and the card functions accept
    // exactly this shape too.
    function isOwnFileImageUrl(url) {
      return url.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/(encoded-hangout-433912-h2\\.firebasestorage\\.app|sonflash-staging-20260906\\.firebasestorage\\.app)/o/users%2F[A-Za-z0-9_-]{1,128}%2Ffiles%2F[A-Za-z0-9_-]{20,64}[?]alt=media&token=[A-Za-z0-9-]{16,64}$')
        && url.split('%2F')[1] == request.auth.uid;
    }

    function isValidBoundedStringList(values) {
      let valueCount = values.size();
      return values is list
        && valueCount <= 4
        && (valueCount < 1 || (values[0] is string && values[0].size() <= 100))
        && (valueCount < 2 || (values[1] is string && values[1].size() <= 100))
        && (valueCount < 3 || (values[2] is string && values[2].size() <= 100))
        && (valueCount < 4 || (values[3] is string && values[3].size() <= 100));
    }

    // Up to 8 distinct learner tags, each 1-32 characters with no surrounding
    // whitespace, comma or line break (the server's card schema runs the same
    // pattern). Rules cannot loop and per-index checks cost about 25
    // expressions a tag, so the list is joined with a comma, which no tag may
    // contain: one pattern checks every piece and the count, and splitting
    // the joined text back must give the stored list exactly, which rejects a
    // tag that smuggles a comma in and any element that is not a string
    // (join turns a number into text).
    function isValidCardTags(tags) {
      return tags is list
        && tags.toSet().size() == tags.size()
        && (tags.size() == 0 || isValidJoinedCardTags(tags.join(','), tags));
    }

    function isValidJoinedCardTags(joined, tags) {
      return joined.matches('^[^\\s,]([^,\\r\\n]{0,30}[^\\s,])?(,[^\\s,]([^,\\r\\n]{0,30}[^\\s,])?){0,7}$')
        && joined.split(',') == tags;
    }

    function isValidCurrentPublicSharedDeck(data) {
      return data.keys().hasAll(['category', 'cards', 'createdAt', 'expiresAt', 'schemaVersion'])
        && data.keys().hasOnly(['category', 'cards', 'createdAt', 'expiresAt', 'schemaVersion', 'targetLanguage', 'nativeLanguage'])
        && data.category is string
        && data.category.size() <= 128
        && data.cards is list
        && data.cards.size() <= 100
        && data.createdAt is timestamp
        && data.expiresAt is timestamp
        && data.schemaVersion == 2
        && (!data.keys().hasAny(['targetLanguage', 'nativeLanguage']) || (
          data.keys().hasAll(['targetLanguage', 'nativeLanguage'])
          && data.targetLanguage is string
          && data.targetLanguage.size() <= 16
          && data.nativeLanguage is string
          && data.nativeLanguage.size() <= 16
        ));
    }

    function isSharedDeckQuarantined(shareId) {
      return exists(/databases/$(database)/documents/admin_shared_deck_migration_quarantine/$(shareId));
    }

    function hasLibraryEpochState(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/profile/library_state);
    }

    function currentLibraryEpoch(userId) {
      return hasLibraryEpochState(userId)
        ? get(/databases/$(database)/documents/users/$(userId)/profile/library_state).data.libraryEpoch
        : 0;
    }

    // The fence flag lives on profile/library_state (see isValidLibraryState)
    // rather than on a standalone profile/library_migration_fence document.
    // Every caller of this function already calls currentLibraryEpoch(userId)
    // (or hasLibraryEpochState(userId)) in the same rule evaluation, so this
    // get() lands on a document path Firestore has already cached for this
    // request and costs no additional dependent-document read. A missing
    // library_state doc, or one without the field, means "not fenced" — the
    // same default a missing standalone fence doc gave before this document
    // shape was merged.
    function hasActiveLibraryMigrationFence(userId) {
      return hasLibraryEpochState(userId)
        && get(/databases/$(database)/documents/users/$(userId)/profile/library_state)
          .data.get('libraryMigrationFenceActive', false) == true;
    }

    function isValidProtocolCounter(value) {
      return value is int
        && value >= 0
        && value <= 9007199254740991;
    }

    // epoch is the caller's single currentLibraryEpoch(userId) lookup, passed
    // in rather than recomputed here. The cards/{cardId} update rule was
    // measured to call currentLibraryEpoch(userId) independently from this
    // function (old and new data), canUpdateCurrentCard, and the course-index
    // mirror check, which alone consumed a large share of the Rules
    // per-request 1,000-expression ceiling.
    function isCurrentProtocolCard(data, epoch) {
      return data.keys().hasAll(['schemaVersion', 'revision', 'libraryEpoch'])
        && data.schemaVersion == 2
        && isValidProtocolCounter(data.revision)
        && data.revision > 0
        && isValidProtocolCounter(data.libraryEpoch)
        && data.libraryEpoch == epoch;
    }

    function isLegacyCard(data) {
      return !data.keys().hasAny(['libraryEpoch']);
    }

    function isNextCardRevision(previous, nextRevision) {
      return (
        !previous.keys().hasAny(['revision'])
        && nextRevision == 1
      ) || (
        previous.keys().hasAny(['revision'])
        && previous.revision is int
        && previous.revision >= 0
        && previous.revision < 9007199254740991
        && nextRevision == previous.revision + 1
      );
    }

    function isNewerTombstone(previous, next) {
      return next.libraryEpoch > previous.libraryEpoch
        || (
          next.libraryEpoch == previous.libraryEpoch
          && next.revision > previous.revision
        );
    }

    function isOldCardGeneration(userId, data) {
      return hasLibraryEpochState(userId)
        && (
          isLegacyCard(data)
          || (
            data.keys().hasAny(['libraryEpoch'])
            && data.libraryEpoch is int
            && data.libraryEpoch < currentLibraryEpoch(userId)
          )
        );
    }

    // The new data must be a current-protocol card (isCurrentProtocolCard)
    // carrying the next revision. isNextCardRevision already pins that
    // revision between 1 and the counter maximum, so only its type is left
    // to check, which costs fewer expressions than isValidProtocolCounter and
    // `> 0` again.
    function canUpdateCurrentCard(data, epoch) {
      return data.keys().hasAll(['schemaVersion', 'revision', 'libraryEpoch'])
        && data.schemaVersion == 2
        && data.revision is int
        && isValidProtocolCounter(data.libraryEpoch)
        && data.libraryEpoch == epoch
        && isNextCardRevision(resource.data, data.revision)
        && (
          (!resource.data.keys().hasAny(['libraryEpoch'])
            && epoch == 0)
          || (
            resource.data.libraryEpoch is int
            && resource.data.libraryEpoch == epoch
          )
        );
    }

    function canInitializeLegacyDifficulty(data, changed) {
      return !resource.data.keys().hasAny(['difficulty'])
        && changed.hasAny(['difficulty'])
        && data.difficulty == 'unrated';
    }

    function hasValidDeletionBarrier(userId, cardId, data) {
      let tombstone = /databases/$(database)/documents/users/$(userId)/card_tombstones/$(cardId);
      return existsAfter(tombstone)
        && (
          !exists(tombstone)
          || isNewerTombstone(get(tombstone).data, getAfter(tombstone).data)
        )
        && isValidCardTombstone(userId, cardId, getAfter(tombstone).data)
        && (
          (
            data.keys().hasAny(['revision'])
            && isValidProtocolCounter(data.revision)
            && data.revision < 9007199254740991
            && getAfter(tombstone).data.revision == data.revision + 1
          )
          || (
            !data.keys().hasAny(['revision'])
            && getAfter(tombstone).data.revision == 1
          )
        );
    }

    function isValidXpClientId(clientId) {
      return clientId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$')
        && clientId != '__proto__'
        && clientId != 'constructor'
        && clientId != 'prototype';
    }

    function isValidAppliedXpSequence(sequence) {
      return sequence is int
        && sequence > 0
        && sequence <= 9007199254740991;
    }

    function isValidAppliedXpClientSequence(clientId, sequence) {
      return isValidXpClientId(clientId)
        && isValidAppliedXpSequence(sequence);
    }

    function isValidXpOperationId(operationId) {
      let operationLength = operationId is string ? operationId.size() : -1;
      return operationId is string
        && operationLength > 0
        && operationLength <= 128
        && operationId.matches('^[A-Za-z0-9][A-Za-z0-9:_-]*$');
    }

    function isValidAppliedXpOperationIdList(operationIds) {
      let operationCount = operationIds is list ? operationIds.size() : -1;
      return operationIds is list
        && operationCount <= 2048
        && (operationCount < 1 || isValidXpOperationId(operationIds[0]))
        && (operationCount < 2 || isValidXpOperationId(operationIds[1]))
        && (operationCount < 3 || isValidXpOperationId(operationIds[2]))
        && (operationCount < 4 || isValidXpOperationId(operationIds[3]))
        // Operation IDs never contain '|', so joining lets Rules enforce the
        // same safe-character and length boundary for every remaining item.
        && (operationCount < 1 || operationIds.join('|').matches(
          '^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}(\\|[A-Za-z0-9][A-Za-z0-9:_-]{0,127})*$',
        ));
    }

    function isValidXpRetiredAt(value) {
      return value == null
        || (
          value is string
          && value.size() == 24
          && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$')
        );
    }

    function isValidGamificationStats(data) {
      return data.keys().hasAll([
          'streak', 'xp', 'lastActive', 'appliedXpOperationIds',
          'xpStreamSchemaVersion'
        ])
        && data.keys().hasOnly([
          'streak', 'xp', 'lastActive', 'appliedXpOperationIds',
          'xpStreamSchemaVersion', 'reviewActivityV1'
        ])
        && data.streak is int
        && data.streak >= 0
        && data.streak <= 9007199254740991
        && data.xp is int
        && data.xp >= 0
        && data.xp <= 9007199254740991
        && (
          data.lastActive == null
          || (
            data.lastActive is string
            && data.lastActive.size() <= 64
          )
        )
        && data.appliedXpOperationIds is list
        && data.appliedXpOperationIds.size() <= 2048
        && isValidAppliedXpOperationIdList(data.appliedXpOperationIds)
        && data.xpStreamSchemaVersion == 2;
    }

    function isValidXpStreamDocument(clientId, data) {
      return data.keys().hasAll(['schemaVersion', 'clientId', 'sequence', 'retiredAt'])
        && data.keys().hasOnly(['schemaVersion', 'clientId', 'sequence', 'retiredAt'])
        && data.schemaVersion == 2
        && isValidAppliedXpClientSequence(clientId, data.sequence)
        && data.clientId == clientId
        && isValidXpRetiredAt(data.retiredAt);
    }

    function isValidGamificationHistory(data) {
      let historyKeys = data is map ? data.keys() : [];
      let historyCount = historyKeys.size();
      return data is map
        && data.keys().size() <= 730
        && historyCount <= 730
        && (historyCount < 1 || (
          historyKeys[0] is string
          && historyKeys[0].size() > 0
          && historyKeys[0].size() <= 64
          && historyKeys[0] != '__proto__'
          && historyKeys[0] != 'constructor'
          && historyKeys[0] != 'prototype'
          && data.get(historyKeys[0], null) is int
          && data.get(historyKeys[0], null) >= 0
          && data.get(historyKeys[0], null) <= 9007199254740991
        ))
        && (historyCount < 2 || (
          historyKeys[1] is string
          && historyKeys[1].size() > 0
          && historyKeys[1].size() <= 64
          && historyKeys[1] != '__proto__'
          && historyKeys[1] != 'constructor'
          && historyKeys[1] != 'prototype'
          && data.get(historyKeys[1], null) is int
          && data.get(historyKeys[1], null) >= 0
          && data.get(historyKeys[1], null) <= 9007199254740991
        ))
        && (historyCount < 3 || (
          historyKeys[2] is string
          && historyKeys[2].size() > 0
          && historyKeys[2].size() <= 64
          && historyKeys[2] != '__proto__'
          && historyKeys[2] != 'constructor'
          && historyKeys[2] != 'prototype'
          && data.get(historyKeys[2], null) is int
          && data.get(historyKeys[2], null) >= 0
          && data.get(historyKeys[2], null) <= 9007199254740991
        ))
        && (historyCount < 4 || (
          historyKeys[3] is string
          && historyKeys[3].size() > 0
          && historyKeys[3].size() <= 64
          && historyKeys[3] != '__proto__'
          && historyKeys[3] != 'constructor'
          && historyKeys[3] != 'prototype'
          && data.get(historyKeys[3], null) is int
          && data.get(historyKeys[3], null) >= 0
          && data.get(historyKeys[3], null) <= 9007199254740991
        ));
    }

    // libraryMigrationFenceActive is an optional field: the legacy migration
    // engine (Admin SDK, bypasses these Rules) field-merges it onto this same
    // document alongside libraryEpoch so a single get() on this one path
    // answers both "current epoch" and "is a migration fence active" instead
    // of needing a second dependent-document read on a standalone fence doc.
    // A client set()/update() through these Rules only ever touches
    // schemaVersion/libraryEpoch, so the field must stay optional here rather
    // than required.
    function isValidLibraryState(data) {
      return data.keys().hasAll(['schemaVersion', 'libraryEpoch'])
        && data.keys().hasOnly(['schemaVersion', 'libraryEpoch', 'libraryMigrationFenceActive'])
        && data.schemaVersion == 2
        && isValidProtocolCounter(data.libraryEpoch)
        && (!data.keys().hasAny(['libraryMigrationFenceActive']) || data.libraryMigrationFenceActive is bool);
    }

    function isValidCustomDeckProfile(data) {
      let deckCount = data.keys().hasAny(['decks']) && data.decks is list
        ? data.decks.size()
        : -1;
      let joinedDecks = data.keys().hasAny(['decks']) && data.decks is list
        ? data.decks.join('\u001f')
        : '';
      let presetKeys = data.keys().hasAny(['coverPresets']) && data.coverPresets is map
        ? data.coverPresets.keys()
        : [];
      let joinedPresetKeys = presetKeys.join('\u001f');
      return data.keys().hasAll(['decks'])
        && data.keys().hasOnly(['decks', 'coverPresets'])
        && data.decks is list
        && deckCount <= 100
        && (deckCount == 0 || (
          data.decks == joinedDecks.split('\u001f')
          && joinedDecks.matches(
            '^[^\\x{1f}]{1,128}(\\x{1f}[^\\x{1f}]{1,128})*$'
          )
        ))
        && (!data.keys().hasAny(['coverPresets']) || (
          data.coverPresets is map
          && presetKeys.size() <= 1000
          && (presetKeys.size() == 0 || joinedPresetKeys.matches(
            '^d_[A-Za-z0-9_-]{2,512}(\\x{1f}d_[A-Za-z0-9_-]{2,512})*$'
          ))
          && data.coverPresets.values().toSet().hasOnly(['aurora', 'violet', 'amber', 'slate', 'moss'])
        ));
    }

    function isValidLibraryFacetsProfile(data) {
      let categoryKeys = data.keys().hasAny(['categories']) && data.categories is map
        ? data.categories.keys()
        : [];
      let categoryCount = categoryKeys.size();
      return data.keys().hasAll(['categories', 'complete', 'version', 'updatedAt'])
        && data.keys().hasOnly(['categories', 'complete', 'version', 'updatedAt'])
        && data.categories is map
        && categoryCount <= 256
        && data.complete is bool
        && data.version == 1
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedAt.size() <= 128
        && (categoryCount < 1 || (
          categoryKeys[0] is string
          && categoryKeys[0].size() > 0
          && categoryKeys[0].size() <= 128
          && data.categories.get(categoryKeys[0], null) is int
          && data.categories.get(categoryKeys[0], null) >= 0
          && data.categories.get(categoryKeys[0], null) <= 9007199254740991
        ))
        && (categoryCount < 2 || (
          categoryKeys[1] is string
          && categoryKeys[1].size() > 0
          && categoryKeys[1].size() <= 128
          && data.categories.get(categoryKeys[1], null) is int
          && data.categories.get(categoryKeys[1], null) >= 0
          && data.categories.get(categoryKeys[1], null) <= 9007199254740991
        ))
        && (categoryCount < 3 || (
          categoryKeys[2] is string
          && categoryKeys[2].size() > 0
          && categoryKeys[2].size() <= 128
          && data.categories.get(categoryKeys[2], null) is int
          && data.categories.get(categoryKeys[2], null) >= 0
          && data.categories.get(categoryKeys[2], null) <= 9007199254740991
        ))
        && (categoryCount < 4 || (
          categoryKeys[3] is string
          && categoryKeys[3].size() > 0
          && categoryKeys[3].size() <= 128
          && data.categories.get(categoryKeys[3], null) is int
          && data.categories.get(categoryKeys[3], null) >= 0
          && data.categories.get(categoryKeys[3], null) <= 9007199254740991
        ));
    }

    function isValidQueryMigrationProfile(data) {
      return data.keys().hasAll([
          'migrationVersion', 'lastDocumentId', 'complete', 'scanned', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'migrationVersion', 'lastDocumentId', 'complete', 'scanned', 'updatedAt'
        ])
        && data.migrationVersion == 2
        && (
          data.lastDocumentId == null
          || (
            data.lastDocumentId is string
            && data.lastDocumentId.size() <= 128
          )
        )
        && data.complete is bool
        && data.scanned is int
        && data.scanned >= 0
        && data.scanned <= 9007199254740991
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedAt.size() <= 128;
    }

    function isValidCardTombstone(userId, cardId, data) {
      return data.keys().hasAll(['cardId', 'opId', 'libraryEpoch', 'revision', 'deletedAt'])
        && data.keys().hasOnly(['cardId', 'opId', 'libraryEpoch', 'revision', 'deletedAt'])
        && data.cardId == cardId
        && isValidId(cardId)
        && data.opId is string && data.opId.size() > 0 && data.opId.size() <= 64
        && isValidProtocolCounter(data.libraryEpoch)
        && (
          (hasLibraryEpochState(userId) && data.libraryEpoch == currentLibraryEpoch(userId))
          || (!hasLibraryEpochState(userId) && data.libraryEpoch == 0)
        )
        && isValidProtocolCounter(data.revision) && data.revision > 0
        && data.deletedAt is string && data.deletedAt.size() > 0 && data.deletedAt.size() <= 64;
    }

    function cardReservationId(normalizedWord) {
      return hashing.sha256(normalizedWord).toHexString().lower();
    }

    // English reservations retain the historic word-only hash. Other target
    // languages are scoped by the same NUL-delimited identity used by the
    // browser and trusted allocation paths.
    function targetCardReservationId(targetLanguage, normalizedWord) {
      return cardReservationId(targetLanguage + '\u0000' + normalizedWord);
    }

    function isValidStoredCardLanguage(value) {
      return value is string
        && value.size() <= 16
        && value.matches('^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$');
    }

    function isValidStoredTranslationLanguage(value) {
      return value in ['en', 'vi'];
    }

    function isValidCardReservation(reservationId, data) {
      return (data.keys().hasAll(['schemaVersion', 'cardId', 'normalizedWord'])
          && data.keys().hasOnly(['schemaVersion', 'cardId', 'normalizedWord'])
          && data.schemaVersion == 1
          && isValidId(data.cardId)
          && data.normalizedWord is string
          && data.normalizedWord.size() > 0
          && data.normalizedWord.size() <= 256
          && reservationId == cardReservationId(data.normalizedWord))
        || (data.keys().hasAll(['schemaVersion', 'cardId', 'normalizedWord', 'targetLanguage'])
          && data.keys().hasOnly(['schemaVersion', 'cardId', 'normalizedWord', 'targetLanguage'])
          && data.schemaVersion == 1
          && isValidId(data.cardId)
          && data.normalizedWord is string
          && data.normalizedWord.size() > 0
          && data.normalizedWord.size() <= 256
          && isValidStoredCardLanguage(data.targetLanguage)
          && data.targetLanguage != 'en'
          && reservationId == targetCardReservationId(data.targetLanguage, data.normalizedWord))
        || (data.keys().hasAll(['schemaVersion', 'cardId', 'lexemeId'])
          && data.keys().hasOnly(['schemaVersion', 'cardId', 'lexemeId'])
          && data.schemaVersion == 2
          && isValidId(data.cardId)
          && data.lexemeId is string
          && data.lexemeId.matches('^lexeme-[a-f0-9]{1,90}-[a-f0-9]{24}$')
          && reservationId == cardReservationId('lexeme:' + data.lexemeId));
    }

    function hasMatchingCardReservation(userId, cardId, data) {
      let hasLanguage = data.keys().hasAny(['language']);
      let language = data.get('language', '');
      let hasValidLanguage = !hasLanguage || isValidStoredCardLanguage(language);
      let canonical = data.keys().hasAll(['lexemeId'])
        ? 'lexeme:' + data.lexemeId
        : (hasLanguage && language != 'en'
          ? language + '\u0000' + data.normalizedWord
          : data.normalizedWord);
      let reservationId = cardReservationId(canonical);
      let reservation = /databases/$(database)/documents/users/$(userId)/card_reservations/$(reservationId);
      let reservationData = getAfter(reservation).data;
      return canonical is string
        && hasValidLanguage
        && existsAfter(reservation)
        && isValidCardReservation(reservationId, reservationData)
        && reservationData.cardId == cardId
        && ((reservationData.schemaVersion == 1
          && reservationData.normalizedWord == data.normalizedWord
          && ((language == '' || language == 'en')
            ? !reservationData.keys().hasAny(['targetLanguage'])
            : reservationData.targetLanguage == language))
          || (reservationData.schemaVersion == 2 && reservationData.lexemeId == data.lexemeId));
    }

    function hasExistingCardForIdentityRepair(userId, data) {
      let card = /databases/$(database)/documents/users/$(userId)/cards/$(data.cardId);
      // A pre-protocol card may already carry its normalizedWord (older
      // clients wrote it before reservations existed); it can still claim
      // the matching reservation. Schema-2 cards never repair client-side.
      return exists(card)
        && get(card).data.id == data.cardId
        && (
          !get(card).data.keys().hasAny(['normalizedWord'])
          || (get(card).data.normalizedWord == data.normalizedWord
            && get(card).data.get('schemaVersion', 0) != 2)
        )
        && get(card).data.word is string
        && existsAfter(card)
        && getAfter(card).data.word == get(card).data.word
        && data.normalizedWord == get(card).data.word.lower()
        && getAfter(card).data.id == data.cardId
        && getAfter(card).data.normalizedWord == data.normalizedWord;
    }

    function hasCardIdentity(data) {
      return data.keys().hasAny(['normalizedWord'])
        && data.normalizedWord is string
        && data.normalizedWord.size() > 0;
    }

    // A stored card with an identity keeps it: the new data carries the very
    // same non-empty normalizedWord (so hasCardIdentity(data) would add
    // nothing) and the same word, and the card is current or its reservation
    // matches. A stored card without one keeps its word and may claim the
    // identity that word gives, with a matching reservation.
    // hasCardIdentity(resource.data) cannot fail, so one conditional replaces
    // two branches that tested it and its negation. A claimed identity is
    // tested before the absence of one: the same condition, but a claim then
    // spends nothing on hasCardIdentity(data).
    function hasValidCardIdentityUpdate(userId, cardId, data, epoch) {
      return hasCardIdentity(resource.data)
        ? (
          resource.data.normalizedWord == data.normalizedWord
          && resource.data.word == data.word
          && (
            isCurrentProtocolCard(resource.data, epoch)
            || hasMatchingCardReservation(userId, cardId, data)
          )
        )
        : (
          resource.data.word is string
          && data.word == resource.data.word
          && (
            (
              data.get('normalizedWord', null) == resource.data.word.lower()
              && hasMatchingCardReservation(userId, cardId, data)
            )
            || !hasCardIdentity(data)
          )
        );
    }

    function isBoundedText(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function isOptionalBoundedText(data, field, maximum) {
      return isBoundedText(data.get(field, ''), maximum);
    }

    function isValidCardFsrs(fsrs) {
      let fields = fsrs is map ? fsrs.keys() : [];
      return fsrs is map
        && fields.hasAll(['due', 'stability', 'difficulty', 'elapsedDays', 'scheduledDays', 'learningSteps', 'reps', 'lapses', 'state'])
        && fields.hasOnly(['due', 'stability', 'difficulty', 'elapsedDays', 'scheduledDays', 'learningSteps', 'reps', 'lapses', 'state', 'lastReview'])
        && isBoundedText(fsrs.due, 128)
        && fsrs.stability is number && fsrs.stability > 0 && fsrs.stability <= 9007199254740991
        && fsrs.difficulty is number && fsrs.difficulty >= 1 && fsrs.difficulty <= 10
        && fsrs.elapsedDays is int && fsrs.elapsedDays >= 0 && fsrs.elapsedDays <= 9007199254740991
        && fsrs.scheduledDays is int && fsrs.scheduledDays >= 0 && fsrs.scheduledDays <= 9007199254740991
        && fsrs.learningSteps is int && fsrs.learningSteps >= 0 && fsrs.learningSteps <= 9007199254740991
        && fsrs.reps is int && fsrs.reps >= 0 && fsrs.reps <= 9007199254740991
        && fsrs.lapses is int && fsrs.lapses >= 0 && fsrs.lapses <= 9007199254740991
        && fsrs.state is int && fsrs.state >= 0 && fsrs.state <= 3
        && isBoundedText(fsrs.get('lastReview', ''), 128);
    }

    function isValidReviewHistoryEntry(entry) {
      let fields = entry is map ? entry.keys() : [];
      let reviewedAt = entry is map ? entry.get('reviewedAt', '') : '';
      let reviewedAtLength = reviewedAt is string ? reviewedAt.size() : -1;
      let scheduledDays = entry is map ? entry.get('scheduledDays', null) : null;
      let elapsedDays = entry is map ? entry.get('elapsedDays', null) : null;
      return entry is map
        && fields.hasAll(['rating', 'reviewedAt', 'scheduledDays', 'elapsedDays'])
        && fields.hasOnly(['rating', 'reviewedAt', 'scheduledDays', 'elapsedDays'])
        && entry.rating in ['again', 'hard', 'good', 'easy']
        && reviewedAt is string
        && reviewedAtLength > 0
        && reviewedAtLength <= 128
        && scheduledDays is number
        && scheduledDays >= 0
        && scheduledDays <= 9007199254740991
        && elapsedDays is number
        && elapsedDays >= 0
        && elapsedDays <= 9007199254740991;
    }

    function isValidReviewHistory(history) {
      let historyCount = history is list ? history.size() : -1;
      return history is list
        && historyCount <= 100
        && (historyCount < 1 || isValidReviewHistoryEntry(history[0]))
        && (historyCount < 2 || isValidReviewHistoryEntry(history[1]))
        && (historyCount < 3 || isValidReviewHistoryEntry(history[2]))
        && (historyCount < 4 || isValidReviewHistoryEntry(history[3]));
    }

    function isValidCardWordFamily(wordFamily) {
      let fields = wordFamily is map ? wordFamily.keys() : [];
      return wordFamily is map
        && fields.hasOnly(['noun', 'verb', 'adj', 'adv'])
        && isBoundedText(wordFamily.get('noun', ''), 100)
        && isBoundedText(wordFamily.get('verb', ''), 100)
        && isBoundedText(wordFamily.get('adj', ''), 100)
        && isBoundedText(wordFamily.get('adv', ''), 100);
    }

    // Update validation only evaluates fields that this write changes. Legacy
    // cards can retain old sparse values, but every new or changed value must
    // still cross the same bounds as a canonical application write.
    //
    // Rules refuse a request once it evaluates 1,000 expressions, and every
    // operand, call, list item and field read counts, so this chain is shaped
    // by cost as well as meaning:
    // - Fields are grouped behind one group-level changed.hasAny(...) gate, so
    //   an untouched group costs one gate instead of one guard per field. The
    //   groups follow the writers: updatedAt rides on every client patch and
    //   stands alone; the card editor's fields form two groups; the identity
    //   fields form one; everything else a client patch rarely touches sits
    //   behind one outer gate.
    // - In the editor groups, a cheap scalar check is written as
    //   `valid || unchanged`. That is the same condition as
    //   `unchanged || valid`, but a save that changes many fields then pays
    //   for the check alone; only a stored legacy value that fails the check
    //   also pays for the gate. Checks that cost more than the gate (photo
    //   URL, tags, lists, maps) and the rarely touched fields keep the gate
    //   first.
    // - No eager `let` here: Rules evaluate every `let` even when its branch
    //   is skipped.
    // isValidCardUpdate rejects any change to the keys it keeps immutable
    // (origin, lexemeId, language, translationLanguage, senseKey,
    // normalizedLemma, ...) before calling this, so those keys need no checks
    // here.
    function isValidChangedCardFields(data, changed) {
      return (data.get('updatedAt', '') is timestamp
          || isBoundedText(data.get('updatedAt', ''), 128)
          || !changed.hasAny(['updatedAt']))
      && (
        !changed.hasAny([
          'translation', 'explanation', 'explanationTranslation', 'phonetic', 'category',
          'partOfSpeech', 'exampleSentence', 'exampleTranslation', 'mnemonic', 'imageSearchQuery'
        ])
        || (
          (isBoundedText(data.get('translation', ''), 256) || !changed.hasAny(['translation']))
          && (isBoundedText(data.get('explanation', ''), 2048) || !changed.hasAny(['explanation']))
          && (isBoundedText(data.get('explanationTranslation', ''), 2048) || !changed.hasAny(['explanationTranslation']))
          && (isBoundedText(data.get('phonetic', ''), 256) || !changed.hasAny(['phonetic']))
          && (isBoundedText(data.get('category', ''), 128) || !changed.hasAny(['category']))
          && (isBoundedText(data.get('partOfSpeech', ''), 64) || !changed.hasAny(['partOfSpeech']))
          && (isBoundedText(data.get('exampleSentence', ''), 2048) || !changed.hasAny(['exampleSentence']))
          && (isBoundedText(data.get('exampleTranslation', ''), 2048) || !changed.hasAny(['exampleTranslation']))
          && (isBoundedText(data.get('mnemonic', ''), 2048) || !changed.hasAny(['mnemonic']))
          && (isBoundedText(data.get('imageSearchQuery', ''), 256) || !changed.hasAny(['imageSearchQuery']))
        )
      )
      // The photo and the learner's own labels: deck, star, tags and
      // difficulty. Scheduling never reads learnerDifficulty, so it is
      // deliberately not in the scheduling guard of canPatchOwnedCard.
      && (
        !changed.hasAny(['imageUrl', 'customDeck', 'bookmarked', 'tags', 'learnerDifficulty'])
        || (
          (!changed.hasAny(['imageUrl']) || data.get('imageUrl', null) == null || isTrustedImageUrl(data.imageUrl))
          && (data.get('customDeck', null) == null || isBoundedText(data.customDeck, 128) || !changed.hasAny(['customDeck']))
          && (data.get('bookmarked', false) is bool || !changed.hasAny(['bookmarked']))
          && (!changed.hasAny(['tags']) || !data.keys().hasAny(['tags']) || isValidCardTags(data.tags))
          && (data.get('learnerDifficulty', null) == null
            || data.get('learnerDifficulty', null) in ['easy', 'medium', 'hard']
            || !changed.hasAny(['learnerDifficulty']))
        )
      )
      // Identity fields change only when a legacy card is upgraded and claims
      // its identity; they stay outside the rarely touched group below so
      // that upgrade does not open it.
      && (
        !changed.hasAny(['id', 'word', 'normalizedWord'])
        || (
          (!changed.hasAny(['id']) || isBoundedText(data.get('id', ''), 128))
          && (!changed.hasAny(['word']) || isBoundedText(data.get('word', ''), 256))
          && (!changed.hasAny(['normalizedWord']) || isBoundedText(data.get('normalizedWord', ''), 256))
        )
      )
      && (
        !changed.hasAny([
          'emoji', 'audioUrl', 'createdAt', 'lastOpenedAt', 'sortTouchedAt',
          'cefrLevel', 'register', 'commonMistake', 'wordFamily',
          'nextReviewDate', 'difficulty', 'reviews', 'interval', 'easeFactor', 'correctStreak',
          'collocations', 'synonyms', 'antonyms', 'reviewHistory', 'fsrs'
        ])
        || (
          (
            !changed.hasAny(['emoji', 'audioUrl', 'createdAt', 'lastOpenedAt', 'sortTouchedAt', 'cefrLevel', 'register', 'commonMistake', 'wordFamily'])
            || (
              (!changed.hasAny(['emoji']) || isBoundedText(data.get('emoji', ''), 64))
              && (!changed.hasAny(['audioUrl']) || data.get('audioUrl', null) == null || isTrustedAudioUrl(data.audioUrl))
              && (!changed.hasAny(['createdAt']) || isBoundedText(data.get('createdAt', ''), 128))
              && (!changed.hasAny(['lastOpenedAt']) || isOptionalBoundedText(data, 'lastOpenedAt', 128))
              && (!changed.hasAny(['sortTouchedAt']) || isOptionalBoundedText(data, 'sortTouchedAt', 128))
              && (!changed.hasAny(['cefrLevel']) || isOptionalBoundedText(data, 'cefrLevel', 8))
              && (!changed.hasAny(['register']) || isOptionalBoundedText(data, 'register', 64))
              && (!changed.hasAny(['commonMistake']) || isOptionalBoundedText(data, 'commonMistake', 2048))
              && (!changed.hasAny(['wordFamily']) || data.get('wordFamily', null) == null || isValidCardWordFamily(data.wordFamily))
            )
          )
          && (
            !changed.hasAny(['nextReviewDate', 'difficulty', 'reviews', 'interval', 'easeFactor', 'correctStreak'])
            || (
              (!changed.hasAny(['nextReviewDate']) || isOptionalBoundedText(data, 'nextReviewDate', 128))
              && (!changed.hasAny(['difficulty']) || data.get('difficulty', '') in ['easy', 'good', 'hard', 'unrated'])
              && (!changed.hasAny(['reviews']) || (data.get('reviews', 0) is int && data.get('reviews', 0) >= 0 && data.get('reviews', 0) <= 9007199254740991))
              && (!changed.hasAny(['interval']) || (data.get('interval', 0) is number && data.get('interval', 0) >= 0 && data.get('interval', 0) <= 9007199254740991))
              && (!changed.hasAny(['easeFactor']) || (data.get('easeFactor', 0) is number && data.get('easeFactor', 0) >= 0 && data.get('easeFactor', 0) <= 5))
              && (!changed.hasAny(['correctStreak']) || (data.get('correctStreak', 0) is int && data.get('correctStreak', 0) >= 0 && data.get('correctStreak', 0) <= 9007199254740991))
            )
          )
          && (
            !changed.hasAny(['collocations', 'synonyms', 'antonyms', 'reviewHistory', 'fsrs'])
            || (
              (!changed.hasAny(['collocations']) || !data.keys().hasAny(['collocations']) || isValidBoundedStringList(data.collocations))
              && (!changed.hasAny(['synonyms']) || !data.keys().hasAny(['synonyms']) || isValidBoundedStringList(data.synonyms))
              && (!changed.hasAny(['antonyms']) || !data.keys().hasAny(['antonyms']) || isValidBoundedStringList(data.antonyms))
              && (!changed.hasAny(['reviewHistory']) || !data.keys().hasAny(['reviewHistory']) || isValidReviewHistory(data.reviewHistory))
              && (!changed.hasAny(['fsrs']) || data.get('fsrs', null) == null || isValidCardFsrs(data.fsrs))
            )
          )
        )
      );
    }

    // The keys of a card update must all be known card fields, the same set
    // a hasOnly([...]) list would name. One pattern over the comma-joined
    // keys costs a handful of expressions where that list literal costs one
    // per name. Each name in the pattern is followed by a comma, so the
    // joined text gets a closing comma and no piece can be empty. A key may
    // itself contain a comma, so the joined text must also split back into
    // exactly as many pieces as there are keys; with no empty piece the
    // counts only match when no key carries a comma, and each piece is then
    // one whole key.
    function hasOnlyCardFields(fields) {
      let joined = fields.join(',');
      return (joined + ',').matches('^((id|origin|lexemeId|language|translationLanguage|senseKey|word|normalizedWord|normalizedLemma|translation|explanation|explanationTranslation|phonetic|category|emoji|audioUrl|imageUrl|imageSearchQuery|createdAt|lastOpenedAt|updatedAt|sortTouchedAt|schemaVersion|revision|libraryEpoch|bookmarked|customDeck|difficulty|nextReviewDate|reviews|interval|easeFactor|correctStreak|partOfSpeech|cefrLevel|exampleSentence|exampleTranslation|collocations|synonyms|antonyms|register|commonMistake|reviewHistory|fsrs|mnemonic|wordFamily|appliedReviewOperationIds|masteredAt|japanesePitchAccent|source|tags|learnerDifficulty|translationAlternatives),)+$')
        && joined.split(',').size() == fields.size();
    }

    // A canonical card stays canonical: no update may remove one of these
    // keys. (Keeping every key present also keeps a fully canonical card
    // fully canonical, which is what this guards.) Most updates remove no key
    // at all, and then the 30-name list is never built.
    // The new data must still hold id, word and translation, which every
    // canonical card holds too.
    // mapDiff and changed come from the one data.diff(resource.data) that
    // canPatchOwnedCard computes for the whole chain.
    function isValidCardUpdate(data, mapDiff, changed) {
      let fields = data.keys();
      return hasOnlyCardFields(fields)
        && (
          mapDiff.removedKeys().size() == 0
          || !mapDiff.removedKeys().hasAny([
            'id', 'word', 'normalizedWord', 'translation', 'explanation',
            'explanationTranslation', 'phonetic', 'category', 'emoji', 'audioUrl',
            'imageUrl', 'imageSearchQuery', 'createdAt', 'bookmarked', 'customDeck',
            'difficulty', 'reviews', 'interval', 'easeFactor', 'correctStreak',
            'partOfSpeech', 'cefrLevel', 'exampleSentence', 'exampleTranslation',
            'collocations', 'synonyms', 'antonyms', 'register', 'commonMistake',
            'reviewHistory'
          ])
        )
        // Server-owned origin, capture, mastery, pitch, AI meaning alternatives
        // and canonical lexeme identity cannot be introduced, removed or
        // changed by a client update.
        && !changed.hasAny([
          'origin', 'source', 'masteredAt', 'japanesePitchAccent', 'translationAlternatives',
          'lexemeId', 'language', 'translationLanguage', 'senseKey', 'normalizedLemma'
        ])
        // language/translationLanguage are immutable after creation (the
        // guard above), so an update never introduces a malformed value
        // through this diff; it only ever carries an already-stored value
        // forward. Revalidating it here still catches a card whose stored
        // value predates this shape (or was written directly), so an
        // unrelated field update can never silently keep coasting on a
        // corrupt language forever.
        // A card without these fields reads as English; 'en' passes both
        // checks, exactly as an absent field did.
        && isValidStoredCardLanguage(data.get('language', 'en'))
        && isValidStoredTranslationLanguage(data.get('translationLanguage', 'en'))
        && fields.hasAll(['id', 'word', 'translation'])
        && (!fields.hasAny(['lexemeId', 'senseKey', 'normalizedLemma'])
          || (fields.hasAll(['lexemeId', 'language', 'senseKey', 'partOfSpeech', 'normalizedLemma'])
            && !changed.hasAny(['partOfSpeech'])))
        && isValidChangedCardFields(data, changed);
    }

    // One library_state lookup and one data.diff(resource.data) for the
    // whole update chain (see isCurrentProtocolCard above). libraryState
    // gives the same epoch as currentLibraryEpoch(userId) and the same fence
    // flag as hasActiveLibraryMigrationFence(userId) without building the
    // document path and reading it a second time. Wrapping the update
    // condition in a function is what makes these `let`s possible; an
    // `allow update: if <expr>` clause cannot declare its own `let`.
    function canPatchOwnedCard(userId, cardId, data) {
      let libraryState = hasLibraryEpochState(userId)
        ? get(/databases/$(database)/documents/users/$(userId)/profile/library_state).data
        : {'libraryEpoch': 0};
      let epoch = libraryState.libraryEpoch;
      let mapDiff = data.diff(resource.data);
      let changed = mapDiff.affectedKeys();
      return libraryState.get('libraryMigrationFenceActive', false) != true
        && data.id == cardId
        && isValidCardUpdate(data, mapDiff, changed)
        && hasValidCardIdentityUpdate(userId, cardId, data, epoch)
        && (
          !changed.hasAny([
            'difficulty', 'nextReviewDate', 'reviews', 'interval', 'easeFactor',
            'correctStreak', 'fsrs', 'reviewHistory', 'appliedReviewOperationIds'
          ])
          || (
            canInitializeLegacyDifficulty(data, changed)
            && !changed.hasAny([
              'nextReviewDate', 'reviews', 'interval', 'easeFactor', 'correctStreak',
              'fsrs', 'reviewHistory', 'appliedReviewOperationIds'
            ])
          )
        )
        && canUpdateCurrentCard(data, epoch);
    }

    // Target match rules for Cards
    match /users/{userId}/cards/{cardId} {
      allow read: if isOwner(userId);
      // Allocation-capable creates are server-only. Authenticated clients use
      // the App Check-protected createCard callable, while updates/deletes keep
      // their owner-scoped revision and tombstone barriers below.
      allow create: if false;
      allow update: if isOwner(userId) && canPatchOwnedCard(userId, cardId, request.resource.data);
      allow delete: if isOwner(userId)
        && !hasActiveLibraryMigrationFence(userId)
        // Catalog cards have a server-owned progress projection. Their delete
        // must go through the callable so both documents change atomically.
        && !resource.data.keys().hasAny(['lexemeId'])
        && (
          isOldCardGeneration(userId, resource.data)
          || hasValidDeletionBarrier(userId, cardId, resource.data)
        );
    }

    // A permanent user-scoped claim for one normalized card identity.
    match /users/{userId}/card_reservations/{reservationId} {
      allow get: if isOwner(userId);
      allow list: if false;
      // A legacy card may claim its missing reservation during the
      // same identity-repair transaction. New card allocation remains server-only.
      allow create: if isOwner(userId)
        && !hasActiveLibraryMigrationFence(userId)
        && isValidCardReservation(reservationId, request.resource.data)
        && hasExistingCardForIdentityRepair(userId, request.resource.data);
      allow update, delete: if false;
    }

    // A point-readable deletion barrier. Listing and client deletion stay blocked.
    match /users/{userId}/card_tombstones/{cardId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && !hasActiveLibraryMigrationFence(userId)
        && isValidCardTombstone(userId, cardId, request.resource.data)
        && exists(/databases/$(database)/documents/users/$(userId)/cards/$(cardId))
        && !existsAfter(/databases/$(database)/documents/users/$(userId)/cards/$(cardId));
      allow update: if isOwner(userId)
        && !hasActiveLibraryMigrationFence(userId)
        && isValidCardTombstone(userId, cardId, request.resource.data)
        && !existsAfter(/databases/$(database)/documents/users/$(userId)/cards/$(cardId))
        && (
          isNewerTombstone(resource.data, request.resource.data)
          || request.resource.data == resource.data
        );
      allow delete: if false;
    }

    match /users/{userId}/review_xp_awards/{awardId} {
      // Award receipts are created and checked only by the review transaction.
      allow read, write: if false;
    }

    match /users/{userId}/profile/library_state {
      allow read: if isOwner(userId);
      // Only the trusted migration engine (Admin SDK, bypasses these Rules)
      // may set libraryMigrationFenceActive; a client create/update can never
      // introduce or change it, so a client cannot self-fence or clear an
      // active fence by shaping its own write payload.
      allow create: if isOwner(userId)
        && !hasActiveLibraryMigrationFence(userId)
        && isValidLibraryState(request.resource.data)
        && !request.resource.data.keys().hasAny(['libraryMigrationFenceActive']);
      allow update: if isOwner(userId)
        && !hasActiveLibraryMigrationFence(userId)
        && isValidLibraryState(request.resource.data)
        && resource.data.libraryEpoch is int
        && request.resource.data.libraryEpoch >= resource.data.libraryEpoch
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['libraryMigrationFenceActive']);
      allow delete: if false;
    }

    // Course profile and query-index control state are server-owned. Owners
    // may read their own documents; callable/Admin code performs every write.
    match /users/{userId}/profile/courses {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // The one-time account profile and the age-restriction marker are written
    // only by the completeAccountProfile callable. Owners may read their own.
    match /users/{userId}/profile/account {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    match /users/{userId}/profile/age_restriction {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    match /users/{userId}/profile/stats {
      // Admin writers validate nested review activity; clients cannot mutate stats.
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Latest exam scores the learner reports for their goals. The setLatestExamScore callable
    // validates and performs every write; owners may only read their own document.
    match /users/{userId}/profile/exam_scores {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    match /users/{userId}/reminderState/{stateId} {
      allow get: if isOwner(userId) && stateId == 'current';
      allow list, create, update, delete: if false;
    }

    match /users/{userId}/pushTokens/{tokenId} {
      allow read, write: if false;
    }

    match /users/{userId}/pushTokenSessionCutoffs/{tokenId} {
      allow read, write: if false;
    }

    match /pushTokenOwners/{tokenId} {
      allow read, write: if false;
    }

    match /users/{userId}/reminderReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Reward inventory is server-authoritative. Owners may only hydrate their
    // own inventory; callable/Admin code performs every mutation.
    match /users/{userId}/profile/rewards {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Verified-create replay receipts and verified-practice session state are
    // callable/Admin-only so clients cannot forge outcomes or inspect them.
    match /users/{userId}/card_create_receipts/{opId} {
      allow read, write: if false;
    }

    match /users/{userId}/practice_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /users/{userId}/profile/plan {
      allow get: if isOwner(userId);
      allow list, write: if false;
    }

    match /users/{userId}/ai_usage/{periodKey} {
      allow get: if isOwner(userId);
      allow list, write: if false;
    }

    match /users/{userId}/ai_operations/{operationId} {
      allow read, write: if false;
    }

    match /users/{userId}/ai_daily/{day} {
      allow read, write: if false;
    }

    match /users/{userId}/xp_streams/{clientId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    match /users/{userId}/profile/xp_history {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    match /users/{userId}/profile/custom_decks {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && !hasActiveLibraryMigrationFence(userId)
        && isValidCustomDeckProfile(request.resource.data);
      allow delete: if false;
    }

    match /users/{userId}/profile/library_facets {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Facet mutation receipts contain server-authoritative replay results.
    // Only the callable's Admin SDK transaction may read or write them.
    match /users/{userId}/library_facet_receipts/{opId} {
      allow read, write: if false;
    }

    match /users/{userId}/profile/query_migration {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && !hasActiveLibraryMigrationFence(userId)
        && isValidQueryMigrationProfile(request.resource.data);
      allow delete: if false;
    }

    // Discovery manifests and leases are server-only trusted migration state.
    // The browser-facing profile/query_migration document above is advisory
    // progress and is never a cursor, manifest, or lease authority.
    match /users/{userId}/admin_library_migration_jobs/{jobId} {
      allow read, write: if false;
      match /groups/{groupId} {
        allow read, write: if false;
      }
    }

    // Card allocation accounting is trusted server state. Admin SDK writes
    // bypass Rules after the callable's transaction checks the owner cap. The
    // owner may read it: onboardingStartedAt tells a second browser that the
    // library holds starter cards, not an existing learner's cards.
    match /users/{userId}/profile/resource_usage {
      allow get: if isOwner(userId);
      allow list, write: if false;
    }

    // Unsupported profile names are deny-only. Explicit matches above are the
    // complete client profile API; server/Admin writes bypass Rules.
    match /users/{userId}/profile/{profileDocId} {
      // Keep the supported-name exclusions visible to source-level guards.
      // profileDocId != 'library_state'
      // profileDocId != 'courses'
      // profileDocId != 'stats'
      // profileDocId != 'rewards'
      // profileDocId != 'plan'
      // profileDocId != 'xp_history'
      // profileDocId != 'resource_usage'
      // profileDocId != 'exam_scores'
      // profileDocId != 'account'
      // profileDocId != 'age_restriction'
      allow read, write: if false;
    }

    // Published catalog data is globally readable but only trusted server-side
    // tooling may create, publish, change or delete it.
    match /lexemes/{lexemeId} {
      allow read: if resource.data.schemaVersion == 3
        && resource.data.provenance is map
        && resource.data.provenance.editorialStatus == 'published';
      allow create, update, delete: if false;
    }

    match /track_memberships/{membershipId} {
      allow read: if resource.data.schemaVersion == 3
        && resource.data.editorialStatus == 'published';
      allow create, update, delete: if false;
    }

    // Phase 2 keeps progress private and read-only to clients. Mutations must go
    // through future trusted server/Admin code, where strict parsing and atomic
    // revision/epoch checks can be enforced together without a bypass path.
    match /users/{userId}/learning_states/{lexemeId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Paths joins this server-owned projection with the downloaded catalog.
    // Only trusted callable code creates, updates, or removes it.
    match /users/{userId}/catalog_progress/{lexemeId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Editorial candidates, immutable revisions and audit evidence are trusted
    // pipeline inputs. They are never a client-readable or client-writable API.
    match /catalog_candidates/{candidateId} {
      allow read, write: if false;
    }

    match /catalog_revisions/{revisionId} {
      allow read, write: if false;
    }

    match /catalog_audit/{eventId} {
      allow read, write: if false;
    }

    // Trigger Email consumes these documents with Admin privileges. Clients
    // must not enqueue mail or read a recipient's digest.
    match /mail/{messageId} {
      allow read, write: if false;
    }

    // Ownership metadata is server-only. It must never be exposed through a
    // public share link or writable by a client.
    match /shared_deck_owners/{shareId} {
      allow read, write: if false;
    }

    // Target match rules for Shared Decks
    match /shared_decks/{shareId} {
      // Public links expose only the exact owner-free schema 2 shape and only
      // while their bounded lease is live.
      allow get: if isValidCurrentPublicSharedDeck(resource.data)
        && resource.data.expiresAt > request.time
        && !isSharedDeckQuarantined(shareId);
      allow list: if false;
      // Creation and revocation go through App Check-protected callable functions.
      // Admin SDK writes bypass Rules after server-side schema/rate-limit checks.
      allow create, update, delete: if false;
    }
  }
}
