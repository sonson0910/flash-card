rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Master Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Safety Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isTrustedAudioUrl(url) {
      return url is string
        && url.size() <= 2048
        && url.matches('^https://(api\\.dictionaryapi\\.dev|ssl\\.gstatic\\.com)/.*$');
    }

    function isTrustedImageUrl(url) {
      return url is string
        && url.size() <= 2048
        && url.matches('^https://(images\\.pexels\\.com|images\\.unsplash\\.com|upload\\.wikimedia\\.org)/.*$');
    }

    function isValidBoundedStringList(values) {
      let valueCount = values.size();
      return values is list
        && valueCount <= 4
        && (valueCount < 1 || (values[0] is string && values[0].size() <= 100))
        && (valueCount < 2 || (values[1] is string && values[1].size() <= 100))
        && (valueCount < 3 || (values[2] is string && values[2].size() <= 100))
        && (valueCount < 4 || (values[3] is string && values[3].size() <= 100));
    }

    function isValidLegacyPublicSharedDeck(data) {
      return data.keys().hasAll(['category', 'cards', 'createdAt'])
        && data.keys().hasOnly(['category', 'cards', 'createdAt'])
        && data.category is string
        && data.category.size() <= 128
        && data.cards is list
        && data.cards.size() <= 100
        && data.createdAt is string
        && data.createdAt.size() <= 128;
    }

    // Exact shape emitted by the schema-1 callable. This temporary read-only
    // bridge can be removed after every pre-migration share has reached its TTL.
    function isValidTransitionalCallableSharedDeck(data) {
      return data.keys().hasAll([
          'authorUid', 'category', 'cards', 'createdAt', 'expiresAt', 'schemaVersion'
        ])
        && data.keys().hasOnly([
          'authorUid', 'category', 'cards', 'createdAt', 'expiresAt', 'schemaVersion'
        ])
        && data.authorUid is string
        && data.authorUid.size() > 0
        && data.authorUid.size() <= 128
        && data.category is string
        && data.category.size() <= 128
        && data.cards is list
        && data.cards.size() <= 100
        && data.createdAt is timestamp
        && data.expiresAt is timestamp
        && data.schemaVersion == 1;
    }

    function isValidCurrentPublicSharedDeck(data) {
      return data.keys().hasAll(['category', 'cards', 'createdAt', 'expiresAt', 'schemaVersion'])
        && data.keys().hasOnly(['category', 'cards', 'createdAt', 'expiresAt', 'schemaVersion'])
        && data.category is string
        && data.category.size() <= 128
        && data.cards is list
        && data.cards.size() <= 100
        && data.createdAt is timestamp
        && data.expiresAt is timestamp
        && data.schemaVersion == 2;
    }

    function hasLibraryEpochState(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/profile/library_state);
    }

    function currentLibraryEpoch(userId) {
      return hasLibraryEpochState(userId)
        ? get(/databases/$(database)/documents/users/$(userId)/profile/library_state).data.libraryEpoch
        : 0;
    }

    function isValidProtocolCounter(value) {
      return value is int
        && value >= 0
        && value <= 9007199254740991;
    }

    function isCurrentProtocolCard(userId, data) {
      return data.keys().hasAll(['schemaVersion', 'revision', 'libraryEpoch'])
        && data.schemaVersion == 2
        && isValidProtocolCounter(data.revision)
        && data.revision > 0
        && isValidProtocolCounter(data.libraryEpoch)
        && data.libraryEpoch == currentLibraryEpoch(userId);
    }

    function isLegacyCard(data) {
      return !data.keys().hasAny(['libraryEpoch']);
    }

    function isNextCardRevision(previous, nextRevision) {
      return (
        !previous.keys().hasAny(['revision'])
        && nextRevision == 1
      ) || (
        previous.keys().hasAny(['revision'])
        && previous.revision is int
        && previous.revision >= 0
        && previous.revision < 9007199254740991
        && nextRevision == previous.revision + 1
      );
    }

    function isNewerTombstone(previous, next) {
      return next.libraryEpoch > previous.libraryEpoch
        || (
          next.libraryEpoch == previous.libraryEpoch
          && next.revision > previous.revision
        );
    }

    function isOldCardGeneration(userId, data) {
      return hasLibraryEpochState(userId)
        && (
          isLegacyCard(data)
          || (
            data.keys().hasAny(['libraryEpoch'])
            && data.libraryEpoch is int
            && data.libraryEpoch < currentLibraryEpoch(userId)
          )
        );
    }

    function canUpdateCurrentCard(userId, data) {
      return isCurrentProtocolCard(userId, data)
        && isNextCardRevision(resource.data, data.revision)
        && (
          (!resource.data.keys().hasAny(['libraryEpoch'])
            && currentLibraryEpoch(userId) == 0)
          || (
            resource.data.libraryEpoch is int
            && resource.data.libraryEpoch == currentLibraryEpoch(userId)
          )
        );
    }

    function canInitializeLegacyDifficulty(data) {
      let changed = data.diff(resource.data).affectedKeys();
      return !resource.data.keys().hasAny(['difficulty'])
        && changed.hasAny(['difficulty'])
        && data.difficulty == 'unrated';
    }

    function hasValidDeletionBarrier(userId, cardId, data) {
      let tombstone = /databases/$(database)/documents/users/$(userId)/card_tombstones/$(cardId);
      return existsAfter(tombstone)
        && (
          !exists(tombstone)
          || isNewerTombstone(get(tombstone).data, getAfter(tombstone).data)
        )
        && isValidCardTombstone(userId, cardId, getAfter(tombstone).data)
        && (
          (
            data.keys().hasAny(['revision'])
            && isValidProtocolCounter(data.revision)
            && data.revision < 9007199254740991
            && getAfter(tombstone).data.revision == data.revision + 1
          )
          || (
            !data.keys().hasAny(['revision'])
            && getAfter(tombstone).data.revision == 1
          )
        );
    }

    function isValidXpClientId(clientId) {
      return clientId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$')
        && clientId != '__proto__'
        && clientId != 'constructor'
        && clientId != 'prototype';
    }

    function isValidAppliedXpSequence(sequence) {
      return sequence is int
        && sequence > 0
        && sequence <= 9007199254740991;
    }

    function isValidAppliedXpClientSequence(clientId, sequence) {
      return isValidXpClientId(clientId)
        && isValidAppliedXpSequence(sequence);
    }

    function isValidXpOperationId(operationId) {
      let operationLength = operationId is string ? operationId.size() : -1;
      return operationId is string
        && operationLength > 0
        && operationLength <= 128
        && operationId.matches('^[A-Za-z0-9][A-Za-z0-9:_-]*$');
    }

    function isValidAppliedXpOperationIdList(operationIds) {
      let operationCount = operationIds is list ? operationIds.size() : -1;
      return operationIds is list
        && operationCount <= 2048
        && (operationCount < 1 || isValidXpOperationId(operationIds[0]))
        && (operationCount < 2 || isValidXpOperationId(operationIds[1]))
        && (operationCount < 3 || isValidXpOperationId(operationIds[2]))
        && (operationCount < 4 || isValidXpOperationId(operationIds[3]))
        // Operation IDs never contain '|', so joining lets Rules enforce the
        // same safe-character and length boundary for every remaining item.
        && (operationCount < 1 || operationIds.join('|').matches(
          '^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}(\\|[A-Za-z0-9][A-Za-z0-9:_-]{0,127})*$',
        ));
    }

    function isValidXpRetiredAt(value) {
      return value == null
        || (
          value is string
          && value.size() == 24
          && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$')
        );
    }

    function isValidGamificationStats(data) {
      return data.keys().hasAll([
          'streak', 'xp', 'lastActive', 'appliedXpOperationIds',
          'xpStreamSchemaVersion'
        ])
        && data.keys().hasOnly([
          'streak', 'xp', 'lastActive', 'appliedXpOperationIds',
          'xpStreamSchemaVersion'
        ])
        && data.streak is int
        && data.streak >= 0
        && data.streak <= 9007199254740991
        && data.xp is int
        && data.xp >= 0
        && data.xp <= 9007199254740991
        && (
          data.lastActive == null
          || (
            data.lastActive is string
            && data.lastActive.size() <= 64
          )
        )
        && data.appliedXpOperationIds is list
        && data.appliedXpOperationIds.size() <= 2048
        && isValidAppliedXpOperationIdList(data.appliedXpOperationIds)
        && data.xpStreamSchemaVersion == 2;
    }

    function isValidXpStreamDocument(clientId, data) {
      return data.keys().hasAll(['schemaVersion', 'clientId', 'sequence', 'retiredAt'])
        && data.keys().hasOnly(['schemaVersion', 'clientId', 'sequence', 'retiredAt'])
        && data.schemaVersion == 2
        && isValidAppliedXpClientSequence(clientId, data.sequence)
        && data.clientId == clientId
        && isValidXpRetiredAt(data.retiredAt);
    }

    function isValidGamificationHistory(data) {
      let historyKeys = data is map ? data.keys() : [];
      let historyCount = historyKeys.size();
      return data is map
        && data.keys().size() <= 730
        && historyCount <= 730
        && (historyCount < 1 || (
          historyKeys[0] is string
          && historyKeys[0].size() > 0
          && historyKeys[0].size() <= 64
          && historyKeys[0] != '__proto__'
          && historyKeys[0] != 'constructor'
          && historyKeys[0] != 'prototype'
          && data.get(historyKeys[0], null) is int
          && data.get(historyKeys[0], null) >= 0
          && data.get(historyKeys[0], null) <= 9007199254740991
        ))
        && (historyCount < 2 || (
          historyKeys[1] is string
          && historyKeys[1].size() > 0
          && historyKeys[1].size() <= 64
          && historyKeys[1] != '__proto__'
          && historyKeys[1] != 'constructor'
          && historyKeys[1] != 'prototype'
          && data.get(historyKeys[1], null) is int
          && data.get(historyKeys[1], null) >= 0
          && data.get(historyKeys[1], null) <= 9007199254740991
        ))
        && (historyCount < 3 || (
          historyKeys[2] is string
          && historyKeys[2].size() > 0
          && historyKeys[2].size() <= 64
          && historyKeys[2] != '__proto__'
          && historyKeys[2] != 'constructor'
          && historyKeys[2] != 'prototype'
          && data.get(historyKeys[2], null) is int
          && data.get(historyKeys[2], null) >= 0
          && data.get(historyKeys[2], null) <= 9007199254740991
        ))
        && (historyCount < 4 || (
          historyKeys[3] is string
          && historyKeys[3].size() > 0
          && historyKeys[3].size() <= 64
          && historyKeys[3] != '__proto__'
          && historyKeys[3] != 'constructor'
          && historyKeys[3] != 'prototype'
          && data.get(historyKeys[3], null) is int
          && data.get(historyKeys[3], null) >= 0
          && data.get(historyKeys[3], null) <= 9007199254740991
        ));
    }

    function isValidLibraryState(data) {
      return data.keys().hasAll(['schemaVersion', 'libraryEpoch'])
        && data.keys().hasOnly(['schemaVersion', 'libraryEpoch'])
        && data.schemaVersion == 2
        && isValidProtocolCounter(data.libraryEpoch);
    }

    function isValidCustomDeckProfile(data) {
      let deckCount = data.keys().hasAny(['decks']) && data.decks is list
        ? data.decks.size()
        : -1;
      let joinedDecks = data.keys().hasAny(['decks']) && data.decks is list
        ? data.decks.join('\u001f')
        : '';
      return data.keys().hasAll(['decks'])
        && data.keys().hasOnly(['decks'])
        && data.decks is list
        && deckCount <= 100
        && (deckCount == 0 || (
          data.decks == joinedDecks.split('\u001f')
          && joinedDecks.matches(
            '^[^\\x{1f}]{1,128}(\\x{1f}[^\\x{1f}]{1,128})*$'
          )
        ));
    }

    function isValidLibraryFacetsProfile(data) {
      let categoryKeys = data.keys().hasAny(['categories']) && data.categories is map
        ? data.categories.keys()
        : [];
      let categoryCount = categoryKeys.size();
      return data.keys().hasAll(['categories', 'complete', 'version', 'updatedAt'])
        && data.keys().hasOnly(['categories', 'complete', 'version', 'updatedAt'])
        && data.categories is map
        && categoryCount <= 256
        && data.complete is bool
        && data.version == 1
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedAt.size() <= 128
        && (categoryCount < 1 || (
          categoryKeys[0] is string
          && categoryKeys[0].size() > 0
          && categoryKeys[0].size() <= 128
          && data.categories.get(categoryKeys[0], null) is int
          && data.categories.get(categoryKeys[0], null) >= 0
          && data.categories.get(categoryKeys[0], null) <= 9007199254740991
        ))
        && (categoryCount < 2 || (
          categoryKeys[1] is string
          && categoryKeys[1].size() > 0
          && categoryKeys[1].size() <= 128
          && data.categories.get(categoryKeys[1], null) is int
          && data.categories.get(categoryKeys[1], null) >= 0
          && data.categories.get(categoryKeys[1], null) <= 9007199254740991
        ))
        && (categoryCount < 3 || (
          categoryKeys[2] is string
          && categoryKeys[2].size() > 0
          && categoryKeys[2].size() <= 128
          && data.categories.get(categoryKeys[2], null) is int
          && data.categories.get(categoryKeys[2], null) >= 0
          && data.categories.get(categoryKeys[2], null) <= 9007199254740991
        ))
        && (categoryCount < 4 || (
          categoryKeys[3] is string
          && categoryKeys[3].size() > 0
          && categoryKeys[3].size() <= 128
          && data.categories.get(categoryKeys[3], null) is int
          && data.categories.get(categoryKeys[3], null) >= 0
          && data.categories.get(categoryKeys[3], null) <= 9007199254740991
        ));
    }

    function isValidQueryMigrationProfile(data) {
      return data.keys().hasAll([
          'migrationVersion', 'lastDocumentId', 'complete', 'scanned', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'migrationVersion', 'lastDocumentId', 'complete', 'scanned', 'updatedAt'
        ])
        && data.migrationVersion == 2
        && (
          data.lastDocumentId == null
          || (
            data.lastDocumentId is string
            && data.lastDocumentId.size() <= 128
          )
        )
        && data.complete is bool
        && data.scanned is int
        && data.scanned >= 0
        && data.scanned <= 9007199254740991
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedAt.size() <= 128;
    }

    function isValidCardTombstone(userId, cardId, data) {
      return data.keys().hasAll(['cardId', 'opId', 'libraryEpoch', 'revision', 'deletedAt'])
        && data.keys().hasOnly(['cardId', 'opId', 'libraryEpoch', 'revision', 'deletedAt'])
        && data.cardId == cardId
        && isValidId(cardId)
        && data.opId is string && data.opId.size() > 0 && data.opId.size() <= 64
        && isValidProtocolCounter(data.libraryEpoch)
        && (
          (hasLibraryEpochState(userId) && data.libraryEpoch == currentLibraryEpoch(userId))
          || (!hasLibraryEpochState(userId) && data.libraryEpoch == 0)
        )
        && isValidProtocolCounter(data.revision) && data.revision > 0
        && data.deletedAt is string && data.deletedAt.size() > 0 && data.deletedAt.size() <= 64;
    }

    function cardReservationId(normalizedWord) {
      return hashing.sha256(normalizedWord).toHexString().lower();
    }

    function isValidCardReservation(reservationId, data) {
      return data.keys().hasAll(['schemaVersion', 'cardId', 'normalizedWord'])
        && data.keys().hasOnly(['schemaVersion', 'cardId', 'normalizedWord'])
        && data.schemaVersion == 1
        && isValidId(data.cardId)
        && data.normalizedWord is string
        && data.normalizedWord.size() > 0
        && data.normalizedWord.size() <= 256
        && reservationId == cardReservationId(data.normalizedWord);
    }

    function hasMatchingCardReservation(userId, cardId, data) {
      let reservationId = cardReservationId(data.normalizedWord);
      let reservation = /databases/$(database)/documents/users/$(userId)/card_reservations/$(reservationId);
      let reservationData = getAfter(reservation).data;
      return data.normalizedWord is string
        && existsAfter(reservation)
        && reservationData.schemaVersion == 1
        && reservationData.cardId == cardId
        && reservationData.normalizedWord == data.normalizedWord;
    }

    function hasExistingCardForIdentityRepair(userId, data) {
      let card = /databases/$(database)/documents/users/$(userId)/cards/$(data.cardId);
      return exists(card)
        && get(card).data.id == data.cardId
        && !get(card).data.keys().hasAny(['normalizedWord'])
        && get(card).data.word is string
        && existsAfter(card)
        && getAfter(card).data.word == get(card).data.word
        && data.normalizedWord == get(card).data.word.lower()
        && getAfter(card).data.id == data.cardId
        && getAfter(card).data.normalizedWord == data.normalizedWord;
    }

    function hasCardIdentity(data) {
      return data.keys().hasAny(['normalizedWord'])
        && data.normalizedWord is string
        && data.normalizedWord.size() > 0;
    }

    function hasValidCardIdentityUpdate(userId, cardId, data) {
      return (
        hasCardIdentity(resource.data)
        && hasCardIdentity(data)
        && resource.data.normalizedWord == data.normalizedWord
        && resource.data.word == data.word
        && (
          isCurrentProtocolCard(userId, resource.data)
          || hasMatchingCardReservation(userId, cardId, data)
        )
      ) || (
        !hasCardIdentity(resource.data)
        && resource.data.word is string
        && data.word == resource.data.word
        && (
          !hasCardIdentity(data)
          || (
            data.normalizedWord == resource.data.word.lower()
            && hasMatchingCardReservation(userId, cardId, data)
          )
        )
      );
    }

    function isBoundedText(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function isOptionalBoundedText(data, field, maximum) {
      return isBoundedText(data.get(field, ''), maximum);
    }

    function isOptionalTimestampOrText(data, field, maximum) {
      let value = data.get(field, '');
      return value is timestamp || isBoundedText(value, maximum);
    }

    function isValidCardFsrs(fsrs) {
      let fields = fsrs is map ? fsrs.keys() : [];
      return fsrs is map
        && fields.hasAll(['due', 'stability', 'difficulty', 'elapsedDays', 'scheduledDays', 'learningSteps', 'reps', 'lapses', 'state'])
        && fields.hasOnly(['due', 'stability', 'difficulty', 'elapsedDays', 'scheduledDays', 'learningSteps', 'reps', 'lapses', 'state', 'lastReview'])
        && isBoundedText(fsrs.due, 128)
        && fsrs.stability is number && fsrs.stability >= 0 && fsrs.stability <= 9007199254740991
        && fsrs.difficulty is number && fsrs.difficulty >= 0 && fsrs.difficulty <= 10
        && fsrs.elapsedDays is number && fsrs.elapsedDays >= 0 && fsrs.elapsedDays <= 9007199254740991
        && fsrs.scheduledDays is number && fsrs.scheduledDays >= 0 && fsrs.scheduledDays <= 9007199254740991
        && fsrs.learningSteps is number && fsrs.learningSteps >= 0 && fsrs.learningSteps <= 9007199254740991
        && fsrs.reps is int && fsrs.reps >= 0 && fsrs.reps <= 9007199254740991
        && fsrs.lapses is int && fsrs.lapses >= 0 && fsrs.lapses <= 9007199254740991
        && fsrs.state is int && fsrs.state >= 0 && fsrs.state <= 3
        && isBoundedText(fsrs.get('lastReview', ''), 128);
    }

    function isValidReviewHistoryEntry(entry) {
      let fields = entry is map ? entry.keys() : [];
      let reviewedAt = entry is map ? entry.get('reviewedAt', '') : '';
      let reviewedAtLength = reviewedAt is string ? reviewedAt.size() : -1;
      let scheduledDays = entry is map ? entry.get('scheduledDays', null) : null;
      let elapsedDays = entry is map ? entry.get('elapsedDays', null) : null;
      return entry is map
        && fields.hasAll(['rating', 'reviewedAt', 'scheduledDays', 'elapsedDays'])
        && fields.hasOnly(['rating', 'reviewedAt', 'scheduledDays', 'elapsedDays'])
        && entry.rating in ['again', 'hard', 'good', 'easy']
        && reviewedAt is string
        && reviewedAtLength > 0
        && reviewedAtLength <= 128
        && scheduledDays is number
        && scheduledDays >= 0
        && scheduledDays <= 9007199254740991
        && elapsedDays is number
        && elapsedDays >= 0
        && elapsedDays <= 9007199254740991;
    }

    function isValidReviewHistory(history) {
      let historyCount = history is list ? history.size() : -1;
      return history is list
        && historyCount <= 100
        && (historyCount < 1 || isValidReviewHistoryEntry(history[0]))
        && (historyCount < 2 || isValidReviewHistoryEntry(history[1]))
        && (historyCount < 3 || isValidReviewHistoryEntry(history[2]))
        && (historyCount < 4 || isValidReviewHistoryEntry(history[3]));
    }

    function isValidCardWordFamily(wordFamily) {
      let fields = wordFamily is map ? wordFamily.keys() : [];
      return wordFamily is map
        && fields.hasOnly(['noun', 'verb', 'adj', 'adv'])
        && isBoundedText(wordFamily.get('noun', ''), 100)
        && isBoundedText(wordFamily.get('verb', ''), 100)
        && isBoundedText(wordFamily.get('adj', ''), 100)
        && isBoundedText(wordFamily.get('adv', ''), 100);
    }

    // Update validation only evaluates fields that this write changes. Legacy
    // cards can retain old sparse values, but every new or changed value must
    // still cross the same bounds as a canonical application write. This also
    // keeps a boundary-valid update below Rules' expression limit: a one-field
    // update does not revalidate every unrelated nested list and history entry.
    function isValidChangedCardFields(data, changed) {
      let fields = data.keys();
      let audioUrl = data.get('audioUrl', null);
      let imageUrl = data.get('imageUrl', null);
      let customDeck = data.get('customDeck', null);
      let wordFamily = data.get('wordFamily', null);
      let fsrs = data.get('fsrs', null);
      return (!changed.hasAny(['id']) || isBoundedText(data.get('id', ''), 128))
        && (!changed.hasAny(['word']) || isBoundedText(data.get('word', ''), 256))
        && (!changed.hasAny(['normalizedWord']) || isBoundedText(data.get('normalizedWord', ''), 256))
        && (!changed.hasAny(['translation']) || isBoundedText(data.get('translation', ''), 256))
        && (!changed.hasAny(['explanation']) || isBoundedText(data.get('explanation', ''), 2048))
        && (!changed.hasAny(['explanationTranslation']) || isBoundedText(data.get('explanationTranslation', ''), 2048))
        && (!changed.hasAny(['phonetic']) || isBoundedText(data.get('phonetic', ''), 256))
        && (!changed.hasAny(['category']) || isBoundedText(data.get('category', ''), 128))
        && (!changed.hasAny(['emoji']) || isBoundedText(data.get('emoji', ''), 64))
        && (!changed.hasAny(['audioUrl']) || audioUrl == null || isTrustedAudioUrl(audioUrl))
        && (!changed.hasAny(['imageUrl']) || imageUrl == null || isTrustedImageUrl(imageUrl))
        && (!changed.hasAny(['imageSearchQuery']) || isOptionalBoundedText(data, 'imageSearchQuery', 256))
        && (!changed.hasAny(['createdAt']) || isBoundedText(data.get('createdAt', ''), 128))
        && (!changed.hasAny(['updatedAt']) || isOptionalTimestampOrText(data, 'updatedAt', 128))
        && (!changed.hasAny(['lastOpenedAt']) || isOptionalBoundedText(data, 'lastOpenedAt', 128))
        && (!changed.hasAny(['sortTouchedAt']) || isOptionalBoundedText(data, 'sortTouchedAt', 128))
        && (!changed.hasAny(['customDeck']) || customDeck == null || isBoundedText(customDeck, 128))
        && (!changed.hasAny(['nextReviewDate']) || isOptionalBoundedText(data, 'nextReviewDate', 128))
        && (!changed.hasAny(['difficulty']) || data.get('difficulty', '') in ['easy', 'good', 'hard', 'unrated'])
        && (!changed.hasAny(['bookmarked']) || data.get('bookmarked', false) is bool)
        && (!changed.hasAny(['reviews']) || (data.get('reviews', 0) is int && data.get('reviews', 0) >= 0 && data.get('reviews', 0) <= 9007199254740991))
        && (!changed.hasAny(['interval']) || (data.get('interval', 0) is number && data.get('interval', 0) >= 0 && data.get('interval', 0) <= 9007199254740991))
        && (!changed.hasAny(['easeFactor']) || (data.get('easeFactor', 0) is number && data.get('easeFactor', 0) >= 0 && data.get('easeFactor', 0) <= 5))
        && (!changed.hasAny(['correctStreak']) || (data.get('correctStreak', 0) is int && data.get('correctStreak', 0) >= 0 && data.get('correctStreak', 0) <= 9007199254740991))
        && (!changed.hasAny(['partOfSpeech']) || isOptionalBoundedText(data, 'partOfSpeech', 64))
        && (!changed.hasAny(['cefrLevel']) || isOptionalBoundedText(data, 'cefrLevel', 8))
        && (!changed.hasAny(['exampleSentence']) || isOptionalBoundedText(data, 'exampleSentence', 2048))
        && (!changed.hasAny(['exampleTranslation']) || isOptionalBoundedText(data, 'exampleTranslation', 2048))
        && (!changed.hasAny(['register']) || isOptionalBoundedText(data, 'register', 64))
        && (!changed.hasAny(['commonMistake']) || isOptionalBoundedText(data, 'commonMistake', 2048))
        && (!changed.hasAny(['mnemonic']) || isOptionalBoundedText(data, 'mnemonic', 2048))
        && (!changed.hasAny(['wordFamily']) || wordFamily == null || isValidCardWordFamily(wordFamily))
        && (!changed.hasAny(['collocations']) || !fields.hasAny(['collocations']) || isValidBoundedStringList(data.collocations))
        && (!changed.hasAny(['synonyms']) || !fields.hasAny(['synonyms']) || isValidBoundedStringList(data.synonyms))
        && (!changed.hasAny(['antonyms']) || !fields.hasAny(['antonyms']) || isValidBoundedStringList(data.antonyms))
        && (!changed.hasAny(['reviewHistory']) || !fields.hasAny(['reviewHistory']) || isValidReviewHistory(data.reviewHistory))
        && (!changed.hasAny(['fsrs']) || fsrs == null || isValidCardFsrs(fsrs));
    }

    function isValidCardUpdate(data) {
      let fields = data.keys();
      let previousFields = resource.data.keys();
      let changed = data.diff(resource.data).affectedKeys();
      let isCanonical = fields.hasAll([
        'id', 'word', 'normalizedWord', 'translation', 'explanation',
        'explanationTranslation', 'phonetic', 'category', 'emoji', 'audioUrl',
        'imageUrl', 'imageSearchQuery', 'createdAt', 'bookmarked', 'customDeck',
        'difficulty', 'reviews', 'interval', 'easeFactor', 'correctStreak',
        'partOfSpeech', 'cefrLevel', 'exampleSentence', 'exampleTranslation',
        'collocations', 'synonyms', 'antonyms', 'register', 'commonMistake',
        'reviewHistory'
      ]);
      let wasCanonical = previousFields.hasAll([
        'id', 'word', 'normalizedWord', 'translation', 'explanation',
        'explanationTranslation', 'phonetic', 'category', 'emoji', 'audioUrl',
        'imageUrl', 'imageSearchQuery', 'createdAt', 'bookmarked', 'customDeck',
        'difficulty', 'reviews', 'interval', 'easeFactor', 'correctStreak',
        'partOfSpeech', 'cefrLevel', 'exampleSentence', 'exampleTranslation',
        'collocations', 'synonyms', 'antonyms', 'register', 'commonMistake',
        'reviewHistory'
      ]);
      return fields.hasOnly([
          'id', 'word', 'normalizedWord', 'translation', 'explanation',
          'explanationTranslation', 'phonetic', 'category', 'emoji', 'audioUrl',
          'imageUrl', 'imageSearchQuery', 'createdAt', 'lastOpenedAt', 'updatedAt',
          'sortTouchedAt', 'schemaVersion', 'revision', 'libraryEpoch',
          'bookmarked', 'customDeck', 'difficulty',
          'nextReviewDate', 'reviews', 'interval', 'easeFactor', 'correctStreak',
          'partOfSpeech', 'cefrLevel', 'exampleSentence', 'exampleTranslation',
          'collocations', 'synonyms', 'antonyms', 'register', 'commonMistake',
          'reviewHistory', 'fsrs', 'mnemonic', 'wordFamily', 'appliedReviewOperationIds'
        ])
        && (!wasCanonical || isCanonical)
        && (isCanonical || fields.hasAll(['id', 'word', 'translation']))
        && isValidChangedCardFields(data, changed);
    }

    // Target match rules for Cards
    match /users/{userId}/cards/{cardId} {
      allow read: if isOwner(userId);
      // Allocation-capable creates are server-only. Authenticated clients use
      // the App Check-protected createCard callable, while updates/deletes keep
      // their owner-scoped revision and tombstone barriers below.
      allow create: if false;
      allow update: if isOwner(userId)
        && request.resource.data.id == cardId
        && isValidCardUpdate(request.resource.data)
        && hasValidCardIdentityUpdate(userId, cardId, request.resource.data)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'difficulty', 'nextReviewDate', 'reviews', 'interval', 'easeFactor',
            'correctStreak', 'fsrs', 'reviewHistory', 'appliedReviewOperationIds'
          ])
          || (
            canInitializeLegacyDifficulty(request.resource.data)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'nextReviewDate', 'reviews', 'interval', 'easeFactor', 'correctStreak',
              'fsrs', 'reviewHistory', 'appliedReviewOperationIds'
            ])
          )
        )
        && canUpdateCurrentCard(userId, request.resource.data);
      allow delete: if isOwner(userId)
        && (
          isOldCardGeneration(userId, resource.data)
          || hasValidDeletionBarrier(userId, cardId, resource.data)
        );
    }

    // A permanent user-scoped claim for one normalized card identity.
    match /users/{userId}/card_reservations/{reservationId} {
      allow get: if isOwner(userId);
      allow list: if false;
      // A legacy card may claim its missing reservation during the
      // same identity-repair transaction. New card allocation remains server-only.
      allow create: if isOwner(userId)
        && isValidCardReservation(reservationId, request.resource.data)
        && hasExistingCardForIdentityRepair(userId, request.resource.data);
      allow update, delete: if false;
    }

    // A point-readable deletion barrier. Listing and client deletion stay blocked.
    match /users/{userId}/card_tombstones/{cardId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidCardTombstone(userId, cardId, request.resource.data)
        && !existsAfter(/databases/$(database)/documents/users/$(userId)/cards/$(cardId));
      allow update: if isOwner(userId)
        && isValidCardTombstone(userId, cardId, request.resource.data)
        && !existsAfter(/databases/$(database)/documents/users/$(userId)/cards/$(cardId))
        && (
          isNewerTombstone(resource.data, request.resource.data)
          || request.resource.data == resource.data
        );
      allow delete: if false;
    }

    match /users/{userId}/profile/library_state {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidLibraryState(request.resource.data);
      allow update: if isOwner(userId)
        && isValidLibraryState(request.resource.data)
        && resource.data.libraryEpoch is int
        && request.resource.data.libraryEpoch >= resource.data.libraryEpoch;
      allow delete: if false;
    }

    match /users/{userId}/profile/stats {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    match /users/{userId}/xp_streams/{clientId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    match /users/{userId}/profile/xp_history {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    match /users/{userId}/profile/custom_decks {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidCustomDeckProfile(request.resource.data);
      allow delete: if false;
    }

    match /users/{userId}/profile/library_facets {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    match /users/{userId}/profile/query_migration {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidQueryMigrationProfile(request.resource.data);
      allow delete: if false;
    }

    // Card allocation accounting is trusted server state. Admin SDK writes
    // bypass Rules after the callable's transaction checks the owner cap.
    match /users/{userId}/profile/resource_usage {
      allow read, write: if false;
    }

    // Unsupported profile names are deny-only. Explicit matches above are the
    // complete client profile API; server/Admin writes bypass Rules.
    match /users/{userId}/profile/{profileDocId} {
      // Keep the supported-name exclusions visible to source-level guards.
      // profileDocId != 'library_state'
      // profileDocId != 'stats'
      // profileDocId != 'xp_history'
      // profileDocId != 'resource_usage'
      allow read, write: if false;
    }

    // Published catalog data is globally readable but only trusted server-side
    // tooling may create, publish, change or delete it.
    match /lexemes/{lexemeId} {
      allow read: if resource.data.schemaVersion == 3
        && resource.data.provenance is map
        && resource.data.provenance.editorialStatus == 'published';
      allow create, update, delete: if false;
    }

    match /track_memberships/{membershipId} {
      allow read: if resource.data.schemaVersion == 3
        && resource.data.editorialStatus == 'published';
      allow create, update, delete: if false;
    }

    // Phase 2 keeps progress private and read-only to clients. Mutations must go
    // through future trusted server/Admin code, where strict parsing and atomic
    // revision/epoch checks can be enforced together without a bypass path.
    match /users/{userId}/learning_states/{lexemeId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Editorial candidates, immutable revisions and audit evidence are trusted
    // pipeline inputs. They are never a client-readable or client-writable API.
    match /catalog_candidates/{candidateId} {
      allow read, write: if false;
    }

    match /catalog_revisions/{revisionId} {
      allow read, write: if false;
    }

    match /catalog_audit/{eventId} {
      allow read, write: if false;
    }

    // Ownership metadata is server-only. It must never be exposed through a
    // public share link or writable by a client.
    match /shared_deck_owners/{shareId} {
      allow read, write: if false;
    }

    // Target match rules for Shared Decks
    match /shared_decks/{shareId} {
      // A migrated legacy link is public only after identity metadata has been
      // removed. Current callable-created shares also expire at their TTL.
      allow get: if isValidLegacyPublicSharedDeck(resource.data)
        || (
          isValidTransitionalCallableSharedDeck(resource.data)
          && resource.data.expiresAt > request.time
        )
        || (
          isValidCurrentPublicSharedDeck(resource.data)
          && resource.data.expiresAt > request.time
        );
      allow list: if false;
      // Creation and revocation go through App Check-protected callable functions.
      // Admin SDK writes bypass Rules after server-side schema/rate-limit checks.
      allow create, update, delete: if false;
    }
  }
}
