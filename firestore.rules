rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Master Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Safety Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isTrustedAudioUrl(url) {
      return url is string
        && url.size() <= 2048
        && url.matches('^https://(api\\.dictionaryapi\\.dev|ssl\\.gstatic\\.com)/.*$');
    }

    function isTrustedImageUrl(url) {
      return url is string
        && url.size() <= 2048
        && url.matches('^https://(images\\.pexels\\.com|images\\.unsplash\\.com|upload\\.wikimedia\\.org)/.*$');
    }

    function isValidBoundedStringList(values) {
      return values is list
        && values.size() <= 4
        && (values.size() < 1 || (values[0] is string && values[0].size() <= 100))
        && (values.size() < 2 || (values[1] is string && values[1].size() <= 100))
        && (values.size() < 3 || (values[2] is string && values[2].size() <= 100))
        && (values.size() < 4 || (values[3] is string && values[3].size() <= 100));
    }

    function hasLibraryEpochState(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/profile/library_state);
    }

    function currentLibraryEpoch(userId) {
      return hasLibraryEpochState(userId)
        ? get(/databases/$(database)/documents/users/$(userId)/profile/library_state).data.libraryEpoch
        : 0;
    }

    function isCurrentCardEpoch(userId, data) {
      return (
        !hasLibraryEpochState(userId)
        && (
          !data.keys().hasAny(['schemaVersion', 'libraryEpoch'])
          || (
            data.schemaVersion == 2
            && data.libraryEpoch is int
            && data.libraryEpoch == 0
          )
        )
      ) || (
        hasLibraryEpochState(userId)
        && data.schemaVersion == 2
        && data.libraryEpoch is int
        && currentLibraryEpoch(userId) is int
        && currentLibraryEpoch(userId) >= 0
        && data.libraryEpoch == currentLibraryEpoch(userId)
      );
    }

    function isValidLibraryState(data) {
      return data.keys().hasAll(['schemaVersion', 'libraryEpoch'])
        && data.keys().hasOnly(['schemaVersion', 'libraryEpoch'])
        && data.schemaVersion == 2
        && data.libraryEpoch is int
        && data.libraryEpoch >= 0;
    }

    function isValidCardTombstone(userId, cardId, data) {
      return data.keys().hasAll(['cardId', 'opId', 'libraryEpoch', 'revision', 'deletedAt'])
        && data.keys().hasOnly(['cardId', 'opId', 'libraryEpoch', 'revision', 'deletedAt'])
        && data.cardId == cardId
        && isValidId(cardId)
        && isValidId(data.opId)
        && data.libraryEpoch is int
        && data.libraryEpoch >= 0
        && data.libraryEpoch == currentLibraryEpoch(userId)
        && data.revision is int
        && data.revision > 0
        && data.deletedAt is string
        && data.deletedAt.size() <= 128;
    }

    // Helper to validate incoming card entity
    function isValidCard(data) {
      return data.keys().hasAll(['id', 'word', 'translation'])
        && data.keys().hasOnly([
          'id', 'word', 'normalizedWord', 'translation', 'explanation',
          'explanationTranslation', 'phonetic', 'category', 'emoji', 'audioUrl',
          'imageUrl', 'imageSearchQuery', 'createdAt', 'lastOpenedAt', 'updatedAt',
          'sortTouchedAt', 'schemaVersion', 'revision', 'libraryEpoch',
          'bookmarked', 'customDeck', 'difficulty',
          'nextReviewDate', 'reviews', 'interval', 'easeFactor', 'correctStreak',
          'partOfSpeech', 'cefrLevel', 'exampleSentence', 'exampleTranslation',
          'collocations', 'synonyms', 'antonyms', 'register', 'commonMistake',
          'reviewHistory', 'fsrs'
        ])
        && data.id is string && data.id.size() <= 128
        && (!data.keys().hasAny(['schemaVersion']) || data.schemaVersion == 2)
        && (!data.keys().hasAny(['revision']) || (data.revision is int && data.revision >= 0))
        && (!data.keys().hasAny(['libraryEpoch']) || (data.libraryEpoch is int && data.libraryEpoch >= 0))
        && data.word is string && data.word.size() <= 256
        && (!data.keys().hasAny(['normalizedWord']) || (data.normalizedWord is string && data.normalizedWord.size() <= 256))
        && data.translation is string && data.translation.size() <= 256
        && (!data.keys().hasAny(['phonetic']) || (data.phonetic is string && data.phonetic.size() <= 256))
        && (!data.keys().hasAny(['explanation']) || (data.explanation is string && data.explanation.size() <= 2048))
        && (!data.keys().hasAny(['explanationTranslation']) || (data.explanationTranslation is string && data.explanationTranslation.size() <= 2048))
        && (!data.keys().hasAny(['category']) || (data.category is string && data.category.size() <= 128))
        && (!data.keys().hasAny(['emoji']) || (data.emoji is string && data.emoji.size() <= 64))
        && (!data.keys().hasAny(['audioUrl']) || (data.audioUrl == null || isTrustedAudioUrl(data.audioUrl)))
        && (!data.keys().hasAny(['imageUrl']) || (data.imageUrl == null || isTrustedImageUrl(data.imageUrl)))
        && (!data.keys().hasAny(['imageSearchQuery']) || (data.imageSearchQuery is string && data.imageSearchQuery.size() <= 256))
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 128))
        && (!data.keys().hasAny(['lastOpenedAt']) || (data.lastOpenedAt is string && data.lastOpenedAt.size() <= 128))
        && (!data.keys().hasAny(['sortTouchedAt']) || (data.sortTouchedAt is string && data.sortTouchedAt.size() <= 128))
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp
          || (data.updatedAt is string && data.updatedAt.size() <= 128))
        && (!data.keys().hasAny(['bookmarked']) || data.bookmarked is bool)
        && (!data.keys().hasAny(['customDeck']) || (data.customDeck == null || (data.customDeck is string && data.customDeck.size() <= 128)))
        && (!data.keys().hasAny(['difficulty']) || (data.difficulty in ['easy', 'good', 'hard', 'unrated']))
        && (!data.keys().hasAny(['nextReviewDate']) || (data.nextReviewDate is string && data.nextReviewDate.size() <= 128))
        && (!data.keys().hasAny(['reviews']) || (data.reviews is int && data.reviews >= 0))
        && (!data.keys().hasAny(['interval']) || (data.interval is number && data.interval >= 0))
        && (!data.keys().hasAny(['easeFactor']) || (data.easeFactor is number && data.easeFactor >= 0 && data.easeFactor <= 5))
        && (!data.keys().hasAny(['correctStreak']) || (data.correctStreak is int && data.correctStreak >= 0))
        && (!data.keys().hasAny(['partOfSpeech']) || (data.partOfSpeech is string && data.partOfSpeech.size() <= 64))
        && (!data.keys().hasAny(['cefrLevel']) || (data.cefrLevel is string && data.cefrLevel.size() <= 8))
        && (!data.keys().hasAny(['exampleSentence']) || (data.exampleSentence is string && data.exampleSentence.size() <= 2048))
        && (!data.keys().hasAny(['exampleTranslation']) || (data.exampleTranslation is string && data.exampleTranslation.size() <= 2048))
        && (!data.keys().hasAny(['register']) || (data.register is string && data.register.size() <= 64))
        && (!data.keys().hasAny(['commonMistake']) || (data.commonMistake is string && data.commonMistake.size() <= 2048))
        && (!data.keys().hasAny(['collocations']) || isValidBoundedStringList(data.collocations))
        && (!data.keys().hasAny(['synonyms']) || isValidBoundedStringList(data.synonyms))
        && (!data.keys().hasAny(['antonyms']) || isValidBoundedStringList(data.antonyms))
        && (!data.keys().hasAny(['reviewHistory']) || (data.reviewHistory is list && data.reviewHistory.size() <= 100))
        && (!data.keys().hasAny(['fsrs']) || (
          data.fsrs is map
          && data.fsrs.keys().hasAll(['due', 'stability', 'difficulty', 'elapsedDays', 'scheduledDays', 'learningSteps', 'reps', 'lapses', 'state'])
          && data.fsrs.keys().hasOnly(['due', 'stability', 'difficulty', 'elapsedDays', 'scheduledDays', 'learningSteps', 'reps', 'lapses', 'state', 'lastReview'])
          && data.fsrs.due is string && data.fsrs.due.size() <= 128
          && data.fsrs.stability is number && data.fsrs.stability >= 0
          && data.fsrs.difficulty is number && data.fsrs.difficulty >= 0 && data.fsrs.difficulty <= 10
          && data.fsrs.elapsedDays is number && data.fsrs.elapsedDays >= 0
          && data.fsrs.scheduledDays is number && data.fsrs.scheduledDays >= 0
          && data.fsrs.learningSteps is number && data.fsrs.learningSteps >= 0
          && data.fsrs.reps is int && data.fsrs.reps >= 0
          && data.fsrs.lapses is int && data.fsrs.lapses >= 0
          && data.fsrs.state is int && data.fsrs.state >= 0 && data.fsrs.state <= 3
          && (!data.fsrs.keys().hasAny(['lastReview']) || (data.fsrs.lastReview is string && data.fsrs.lastReview.size() <= 128))
        ));
    }

    // Target match rules for Cards
    match /users/{userId}/cards/{cardId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidId(cardId)
        && request.resource.data.id == cardId
        && isValidCard(request.resource.data)
        && isCurrentCardEpoch(userId, request.resource.data);
      allow delete: if isOwner(userId);
    }

    // A point-readable deletion barrier. Listing and client deletion stay blocked.
    match /users/{userId}/card_tombstones/{cardId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidCardTombstone(userId, cardId, request.resource.data);
      allow update: if isOwner(userId)
        && isValidCardTombstone(userId, cardId, request.resource.data)
        && (
          request.resource.data.revision > resource.data.revision
          || request.resource.data == resource.data
        );
      allow delete: if false;
    }

    match /users/{userId}/profile/library_state {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidLibraryState(request.resource.data);
      allow update: if isOwner(userId)
        && isValidLibraryState(request.resource.data)
        && resource.data.libraryEpoch is int
        && request.resource.data.libraryEpoch >= resource.data.libraryEpoch;
      allow delete: if false;
    }

    // Target match rules for User Profiles (Streak stats, custom decks, xp history, etc.)
    match /users/{userId}/profile/{profileDocId} {
      allow read, write: if isOwner(userId)
        && isValidId(profileDocId)
        && profileDocId != 'library_state';
    }

    // Target match rules for Shared Decks
    match /shared_decks/{shareId} {
      // Legacy links remain readable during migration. New callable-created shares
      // carry expiresAt and become unreadable as soon as their TTL is reached.
      allow get: if !resource.data.keys().hasAny(['expiresAt'])
        || (resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time);
      allow list: if false;
      // Creation and revocation go through App Check-protected callable functions.
      // Admin SDK writes bypass Rules after server-side schema/rate-limit checks.
      allow create, update, delete: if false;
    }
  }
}
