{
  "manifest_version": 3,
  "name": "LingoFlash — Translate & Save",
  "short_name": "LingoFlash",
  "version": "1.2.0",
  "description": "Translate selected English text inline for free, or generate and save one complete LingoFlash flashcard with a single AI request.",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://encoded-hangout-433912-h2.web.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://encoded-hangout-433912-h2.web.app/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "LingoFlash — Dịch nhanh / tạo flashcard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Dịch bằng AI một lần, tạo flashcard và thêm vào LingoFlash"
    },
    "translate-only-selection": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Option+Shift+L"
      },
      "description": "Dịch nhanh tại trang bằng Chrome Translator, không lưu flashcard"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "incognito": "not_allowed"
}
